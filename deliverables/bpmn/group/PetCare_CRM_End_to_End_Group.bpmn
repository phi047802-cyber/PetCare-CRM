      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="266" y="165"/>
        <di:waypoint x="310" y="165"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="375" y="205"/>
        <di:waypoint x="375" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="375" y="400"/>
        <di:waypoint x="375" y="955"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="445" y="995"/>
        <di:waypoint x="465" y="995"/>
        <di:waypoint x="465" y="360"/>
        <di:waypoint x="490" y="360"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="620" y="360"/>
        <di:waypoint x="660" y="360"/>
