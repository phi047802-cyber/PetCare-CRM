        <dc:Bounds x="2045" y="955" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DanhGiaChuKy_di" bpmnElement="Gateway_DanhGiaChuKy">
