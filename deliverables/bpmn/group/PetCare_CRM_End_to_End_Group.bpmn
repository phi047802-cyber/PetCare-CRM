<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PetCare_Group_E2E" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0">
  <bpmn:collaboration id="Collaboration_PetCare_E2E">
    <bpmn:participant id="Participant_PetCare_Clinic" name="Hệ thống PetCare CRM - Quy trình Chăm sóc Khách hàng &amp; Bán hàng Dịch vụ Toàn diện (End-to-End)" processRef="Process_PetCare_Group_E2E"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_PetCare_Group_E2E" name="Quy trình Chăm sóc Khách hàng &amp; Bán hàng Dịch vụ Toàn diện" isExecutable="true">
    <bpmn:laneSet id="LaneSet_PetCare_E2E">
      <bpmn:lane id="Lane_KhachHang" name="Khách hàng (Chủ nuôi thú cưng)">
        <bpmn:flowNodeRef>Start_KhachHangNhuCau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KH_DienForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KH_DuaThuCung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KH_QuetVietQR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KH_NhanThongBao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TaiKhamThanhCong</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MarketingSales" name="Bộ phận Marketing &amp; Bán hàng (Sales / Telesales)">
        <bpmn:flowNodeRef>Task_Sales_TiepNhanLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sales_GoiTuVan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KHTiemNang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sales_DongLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_LeadUnqualified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sales_ConvertLead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MuaGoiHoiVien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sales_TaoOpportunity</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LeTan" name="Lễ tân &amp; Thu ngân (Front Desk / Cashier)">
        <bpmn:flowNodeRef>Task_LT_TiepDon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LT_MoPhieuServiceVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_KiemTraHoiVien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LT_XuatHoaDon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ThanhToanThanhCong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LT_ThuTienMat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LT_BanGiaoPet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_KyThuat" name="Bác sĩ thú y &amp; Kỹ thuật viên Spa (Veterinarian / Groomer)">
        <bpmn:flowNodeRef>Task_KT_KhamCanNang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KT_ThucHienDichVu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KT_GhiNhanKetQua</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CRMSystem" name="Hệ thống CRM &amp; Tự động hóa (PetCare CRM Engine)">
        <bpmn:flowNodeRef>Task_CRM_KiemTraDeduplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CRM_CanTruQuyenLoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CRM_DoiSoatVietQR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CRM_QuetChuKyCareIntelligence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DanhGiaChuKy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CRM_TaoRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ChuKyOnDinh</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_KhachHangNhuCau" name="Khách hàng phát sinh nhu cầu chăm sóc"/>
    <bpmn:userTask id="Task_KH_DienForm" name="Điền Form tư vấn / Đặt lịch trên Website"/>
    <bpmn:userTask id="Task_KH_DuaThuCung" name="Mang thú cưng đến phòng khám / spa"/>
    <bpmn:userTask id="Task_KH_QuetVietQR" name="Quét mã Dynamic VietQR / Thanh toán ví"/>
    <bpmn:receiveTask id="Task_KH_NhanThongBao" name="Nhận thông báo nhắc lịch qua Zalo ZNS / SMS"/>
    <bpmn:endEvent id="End_TaiKhamThanhCong" name="Khách hàng gắn kết &amp; Tái sử dụng dịch vụ"/>
    <bpmn:userTask id="Task_Sales_TiepNhanLead" name="Tiếp nhận Lead từ Form &amp; Chuẩn hóa SĐT"/>
    <bpmn:userTask id="Task_Sales_GoiTuVan" name="Gọi điện tư vấn nhu cầu &amp; thể trạng Pet"/>
    <bpmn:exclusiveGateway id="Gateway_KHTiemNang" name="Khách có tiềm năng?"/>
    <bpmn:userTask id="Task_Sales_DongLead" name="Đóng Lead (Unqualified &amp; ghi rõ lý do)"/>
    <bpmn:endEvent id="End_LeadUnqualified" name="Kết thúc Lead không tiềm năng"/>
    <bpmn:userTask id="Task_Sales_ConvertLead" name="Chuyển đổi Lead sang Contact &amp; Hồ sơ Pet"/>
    <bpmn:exclusiveGateway id="Gateway_MuaGoiHoiVien" name="Có nhu cầu mua Gói Hội viên?"/>
    <bpmn:userTask id="Task_Sales_TaoOpportunity" name="Quản lý Opportunity Pipeline &amp; Chốt Deal"/>
    <bpmn:userTask id="Task_LT_TiepDon" name="Tiếp đón khách &amp; Tra cứu hồ sơ Pet tại quầy"/>
    <bpmn:userTask id="Task_LT_MoPhieuServiceVisit" name="Khởi tạo phiếu dịch vụ (Service Visit)"/>
    <bpmn:exclusiveGateway id="Gateway_KiemTraHoiVien" name="Có Thẻ Hội viên Active?"/>
    <bpmn:userTask id="Task_LT_XuatHoaDon" name="Tạo hóa đơn &amp; Mã Dynamic VietQR"/>
    <bpmn:exclusiveGateway id="Gateway_ThanhToanThanhCong" name="Thanh toán thành công?"/>
    <bpmn:userTask id="Task_LT_ThuTienMat" name="Thu tiền mặt / phần chênh lệch"/>
    <bpmn:userTask id="Task_LT_BanGiaoPet" name="In phiếu quyết toán &amp; Bàn giao Pet cho chủ"/>
    <bpmn:userTask id="Task_KT_KhamCanNang" name="Khám thể trạng lâm sàng &amp; Cân trọng lượng"/>
    <bpmn:userTask id="Task_KT_ThucHienDichVu" name="Thực hiện dịch vụ: Tắm / Cắt tỉa / Vắc-xin"/>
    <bpmn:userTask id="Task_KT_GhiNhanKetQua" name="Cập nhật cân nặng mới &amp; Hoàn thành ca"/>
    <bpmn:serviceTask id="Task_CRM_KiemTraDeduplication" name="Kiểm tra chống trùng lặp Contact/Pet"/>
    <bpmn:serviceTask id="Task_CRM_CanTruQuyenLoi" name="Cấn trừ quyền lợi thẻ (Pessimistic Row Lock)"/>
    <bpmn:serviceTask id="Task_CRM_DoiSoatVietQR" name="Lắng nghe Webhook IPN ngân hàng &amp; Đối soát"/>
    <bpmn:serviceTask id="Task_CRM_QuetChuKyCareIntelligence" name="Quét Care Intelligence: EWMA + IQR + Mùa vụ + Tuổi"/>
    <bpmn:exclusiveGateway id="Gateway_DanhGiaChuKy" name="Đánh giá chu kỳ chăm sóc?"/>
    <bpmn:serviceTask id="Task_CRM_TaoRecommendation" name="Tạo Care Recommendation &amp; Gửi Zalo ZNS"/>
    <bpmn:endEvent id="End_ChuKyOnDinh" name="Hoàn tất đợt chăm sóc (Chu kỳ ổn định)"/>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_KhachHangNhuCau" targetRef="Task_KH_DienForm"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_KH_DienForm" targetRef="Task_Sales_TiepNhanLead"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Sales_TiepNhanLead" targetRef="Task_CRM_KiemTraDeduplication"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CRM_KiemTraDeduplication" targetRef="Task_Sales_GoiTuVan"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Sales_GoiTuVan" targetRef="Gateway_KHTiemNang"/>
    <bpmn:sequenceFlow id="Flow_KhongTiemNang" sourceRef="Gateway_KHTiemNang" targetRef="Task_Sales_DongLead" name="Không tiềm năng"/>
    <bpmn:sequenceFlow id="Flow_EndUnqualified" sourceRef="Task_Sales_DongLead" targetRef="End_LeadUnqualified"/>
    <bpmn:sequenceFlow id="Flow_CoTiemNang" sourceRef="Gateway_KHTiemNang" targetRef="Task_Sales_ConvertLead" name="Khách tiềm năng"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Sales_ConvertLead" targetRef="Gateway_MuaGoiHoiVien"/>
    <bpmn:sequenceFlow id="Flow_CoMuaGoi" sourceRef="Gateway_MuaGoiHoiVien" targetRef="Task_Sales_TaoOpportunity" name="Có nhu cầu gói hội viên"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Sales_TaoOpportunity" targetRef="Task_LT_TiepDon" name="Chốt Deal thành công"/>
    <bpmn:sequenceFlow id="Flow_KhongMuaGoi" sourceRef="Gateway_MuaGoiHoiVien" targetRef="Task_LT_TiepDon" name="Dịch vụ lẻ"/>
    <bpmn:sequenceFlow id="Flow_KH_DuaPetDen" sourceRef="Task_KH_DienForm" targetRef="Task_KH_DuaThuCung"/>
    <bpmn:sequenceFlow id="Flow_KH_VaoQuay" sourceRef="Task_KH_DuaThuCung" targetRef="Task_LT_TiepDon"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_LT_TiepDon" targetRef="Task_KT_KhamCanNang"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_KT_KhamCanNang" targetRef="Task_KT_ThucHienDichVu"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_KT_ThucHienDichVu" targetRef="Task_KT_GhiNhanKetQua"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_KT_GhiNhanKetQua" targetRef="Task_LT_MoPhieuServiceVisit"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_LT_MoPhieuServiceVisit" targetRef="Gateway_KiemTraHoiVien"/>
    <bpmn:sequenceFlow id="Flow_CoHoiVien" sourceRef="Gateway_KiemTraHoiVien" targetRef="Task_CRM_CanTruQuyenLoi" name="Có Thẻ Active &amp; Còn lượt"/>
    <bpmn:sequenceFlow id="Flow_KhongHoiVien" sourceRef="Gateway_KiemTraHoiVien" targetRef="Task_LT_XuatHoaDon" name="Không có thẻ / Hết lượt"/>
    <bpmn:sequenceFlow id="Flow_CanTruXong" sourceRef="Task_CRM_CanTruQuyenLoi" targetRef="Task_LT_XuatHoaDon"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_LT_XuatHoaDon" targetRef="Task_KH_QuetVietQR"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_KH_QuetVietQR" targetRef="Task_CRM_DoiSoatVietQR"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_CRM_DoiSoatVietQR" targetRef="Gateway_ThanhToanThanhCong"/>
    <bpmn:sequenceFlow id="Flow_ThanhToanLoi" sourceRef="Gateway_ThanhToanThanhCong" targetRef="Task_LT_ThuTienMat" name="Chưa khớp / Thiếu tiền"/>
    <bpmn:sequenceFlow id="Flow_ThuTienXong" sourceRef="Task_LT_ThuTienMat" targetRef="Task_LT_BanGiaoPet"/>
    <bpmn:sequenceFlow id="Flow_ThanhToanXong" sourceRef="Gateway_ThanhToanThanhCong" targetRef="Task_LT_BanGiaoPet" name="Khớp lệnh 100%"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_LT_BanGiaoPet" targetRef="Task_CRM_QuetChuKyCareIntelligence"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_CRM_QuetChuKyCareIntelligence" targetRef="Gateway_DanhGiaChuKy"/>
    <bpmn:sequenceFlow id="Flow_CanChamSoc" sourceRef="Gateway_DanhGiaChuKy" targetRef="Task_CRM_TaoRecommendation" name="DUE_SOON / AT_RISK"/>
    <bpmn:sequenceFlow id="Flow_ChuKyOnDinh" sourceRef="Gateway_DanhGiaChuKy" targetRef="End_ChuKyOnDinh" name="STABLE"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_CRM_TaoRecommendation" targetRef="Task_KH_NhanThongBao"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_KH_NhanThongBao" targetRef="End_TaiKhamThanhCong"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_PetCare_E2E">
    <bpmndi:BPMNPlane id="BPMNPlane_PetCare_E2E" bpmnElement="Collaboration_PetCare_E2E">
      <bpmndi:BPMNShape id="Participant_PetCare_Clinic_di" bpmnElement="Participant_PetCare_Clinic" isHorizontal="true">
